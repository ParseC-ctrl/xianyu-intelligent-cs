[Unit]
Description=Xianyu SaaS durable job consumer
After=network-online.target xianyu-intelligent-cs.service
Wants=network-online.target
# The built-in launcher supervises the consumer; skip this legacy unit once the
# launcher heartbeat exists so two consumers never share one database.
ConditionPathExists=!/var/lib/xianyu-intelligent-cs/app-code/launcher.json

[Service]
Type=simple
User=xianyu-intelligent-cs
Group=xianyu-intelligent-cs
WorkingDirectory=/opt/xianyu-intelligent-cs/current/backend
EnvironmentFile=/etc/xianyu-intelligent-cs.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/xianyu-intelligent-cs/current/runtime/site/backend
Environment=SAAS_CURRENT_ROOT=/opt/xianyu-intelligent-cs/current
Environment=SAAS_DEPLOYMENT_MODE=systemd
Environment=SAAS_RELEASE_KIND=standalone
ExecStart=/opt/xianyu-intelligent-cs/current/runtime/python/bin/python3 -m job_consumer

Restart=on-failure
RestartSec=5
TimeoutStopSec=35
KillMode=control-group
UMask=0077
StateDirectory=xianyu-intelligent-cs
StateDirectoryMode=0700
ReadWritePaths=/var/lib/xianyu-intelligent-cs

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
